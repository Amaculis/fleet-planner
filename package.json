{
  "name": "bus-fleet-assets",
  "private": true,
  "description": "Front-end assets: Tailwind build, vendored htmx, and the lx-ui calendar island. No runtime npm dependency beyond what is bundled into web/static.",
  "scripts": {
    "build:css": "tailwindcss -i web/src/app.css -o web/static/css/app.css --minify",
    "build:calendar": "vite build --config vite.calendar.config.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.4",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@dativa-lv/lx-ui": "2.3.12",
    "htmx.org": "2.0.11",
    "vue": "3.5.45"
  }
}
