{
  "name": "bus-fleet-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 / lx-ui single-page app for the Bus Fleet backend, served under /app/.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:demo": "node scripts/copy-demo-fonts.mjs && vite build --mode demo --outDir dist-demo --base=/fleet-planner/",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo --base=/fleet-planner/",
    "test": "vitest --run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dativa-lv/lx-ui": "2.3.10",
    "axios": "^1.7.9",
    "axios-mock-adapter": "^2.1.0",
    "pinia": "^2.1.7",
    "vue": "3.5.44",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "vite": "8.3.5",
    "vitest": "^2.1.8"
  }
}
