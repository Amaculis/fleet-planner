# Copy to .env (git-ignored) and fill in every value. The secrets are left empty on
# purpose: the stack refuses to start until you generate them, so a copied example
# can never run with a guessable secret.
# Generate each secret with:  openssl rand -hex 32
# Use hex (URL-safe) passwords - they are embedded in connection URLs.

APP_DOMAIN=fleet.example.lv
ACME_EMAIL=ops@example.lv

POSTGRES_SUPERUSER_PASSWORD=
FLEET_OWNER_PASSWORD=
FLEET_APP_PASSWORD=

# Keys the pre-login CSRF token. Exactly 32 bytes, hex-encoded (64 hex characters).
# Rotating it invalidates in-flight login forms only, never active sessions.
APP_SECRET=

# Optional overrides (Go duration syntax)
# SESSION_IDLE_TIMEOUT=4h
# SESSION_ABSOLUTE_TIMEOUT=12h

# Backups (see deploy/backup/README.md). age PUBLIC key only; the private key stays offline.
BACKUP_AGE_RECIPIENT=
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=30
