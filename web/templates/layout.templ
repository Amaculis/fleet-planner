package templates

import "github.com/buscompany/bus_fleet/internal/i18n"
import "github.com/buscompany/bus_fleet/internal/domain"
import "strings"
import "encoding/json"

// Layout is the shell for every page. templ escapes every { expression } by default;
// nothing here uses templ.Raw, so user data can never become markup.
//
// The script tags carry the per-request CSP nonce: the policy allows no inline handlers
// and no external origin, so an injected script tag cannot execute. htmx is vendored
// into /static/js — self-hosted, never a CDN.
templ Layout(p *i18n.Printer, nonce string, title string) {
	<!DOCTYPE html>
	<html lang={ p.Locale() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="theme-color" content="#0f172a"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png"/>
			<link rel="icon" href="/static/icons/icon-192.png" sizes="192x192" type="image/png"/>
			<title>{ title } — { p.T("app.name") }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<link rel="manifest" href="/static/manifest.webmanifest"/>
			<!--
				htmx's documented "preferred mechanism" for config (htmx.org/docs/#config):
				read before the htmx script itself runs, avoiding any script-ordering race.
				Needed because htmx.config.includeIndicatorStyles defaults to true and, on
				load, unconditionally injects a <style> element with no nonce, blocked by
				this page's CSP (style-src has no 'unsafe-inline'), even though nothing here
				uses hx-indicator yet. Disabled outright since it is unused; inlineStyleNonce
				is set too, matching this request's real nonce, so it is already correct
				if/when this app starts using htmx's own indicator styling.
			-->
			<meta name="htmx-config" content={ htmxConfigJSON(nonce) }/>
			<script nonce={ nonce } src="/static/js/htmx.min.js" defer></script>
			<script nonce={ nonce } src="/static/js/app.js" defer></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
			<a href="#main" class="sr-only focus:not-sr-only">{ p.T("app.skip_to_content") }</a>
			<!--
				class="lx": every lx-ui design token (icon sizes, colours, spacing, fonts —
				300+ CSS custom properties) is scoped under a bare ".lx" selector in their
				CSS bundle. With nothing carrying that class, none of those variables were
				ever defined anywhere in the page, so every mounted island rendered with
				undefined sizing/colour — the giant unstyled calendar icon was the visible
				symptom, but every other island was silently affected the same way. Placed
				on #main, not <body>: every island (nav, fields, buttons, notifications) is
				rendered inside here (see Page() and Nav()), so this is the smallest common
				ancestor that reaches all of them. rem-based Tailwind sizing elsewhere on
				the page is unaffected — .lx sets a local font-size, and rem never follows
				an ancestor's font-size, only the root's.
			-->
			<main id="main" class="lx mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">
				{ children... }
			</main>
		</body>
	</html>
}

// BrandMark is the small bus glyph next to the app name — an inline SVG, not an
// external icon font, so it costs nothing extra to load and needs no CSP allowance.
templ BrandMark() {
	<svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 shrink-0 text-slate-900" aria-hidden="true">
		<rect x="3" y="5" width="18" height="12" rx="2.5" fill="currentColor"></rect>
		<rect x="6" y="7.5" width="12" height="4" rx="0.5" fill="white" fill-opacity="0.9"></rect>
		<circle cx="7.5" cy="18.5" r="1.75" fill="currentColor"></circle>
		<circle cx="16.5" cy="18.5" r="1.75" fill="currentColor"></circle>
	</svg>
}

// Nav is rendered only for authenticated users. Which links appear is presentation:
// each target route is independently guarded by RequireRole on the server. The active
// link is highlighted from v.Path, which is likewise cosmetic only.
//
// The plain <nav> below is the real thing — it works with no JS at all. Next to it is
// a hidden LxToolbar island (see web/vue/chrome/NavToolbar.vue) that replaces it
// visually on a successful mount and falls back to leaving it alone otherwise. Because
// nav appears on every page, this is the one island that reaches every single page in
// the app, not just forms.
templ Nav(v View) {
	<nav id="site-nav" class="mb-6 flex flex-wrap items-center gap-1 border-b border-slate-200 pb-4">
		<span class="mr-4 flex items-center gap-2 text-base font-semibold text-slate-900">
			@BrandMark()
			{ v.T("app.name") }
		</span>
		if v.Identity.Role == domain.RoleDriver {
			@NavLink(v, "/my/trips", v.T("nav.my_trips"))
		} else {
			@NavLink(v, "/timeline", v.T("nav.timeline"))
			@NavLink(v, "/trips", v.T("nav.trips"))
			@NavLink(v, "/buses", v.T("nav.buses"))
			@NavLink(v, "/drivers", v.T("nav.drivers"))
		}
		if v.Identity.Role == domain.RoleAdmin {
			@NavLink(v, "/users", v.T("nav.users"))
		}
		<form id="logout-form" class="ml-auto" method="post" action="/logout">
			<input type="hidden" name="csrf_token" value={ v.CSRF }/>
			<button type="submit" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
				{ v.T("nav.logout") }
			</button>
		</form>
	</nav>
	<div
		hidden
		data-lx-field
		data-kind="toolbar"
		data-input-id="site-nav"
		data-items={ navItemsJSON(v) }
		data-logout-form-id="logout-form"
		data-locale={ v.BCP47() }
	></div>
}

// navItem mirrors what web/vue/chrome/NavToolbar.vue expects: {id, name, href, active}.
type navItem struct {
	ID     string `json:"id"`
	Name   string `json:"name"`
	Href   string `json:"href"`
	Active bool   `json:"active"`
}

// navItemsJSON mirrors the plain <nav> above exactly — same links, same role gating,
// same active-page logic — so the toolbar and its fallback can never show different
// navigation. The logout action carries no href: NavToolbar.vue special-cases its id
// and submits #logout-form instead of navigating, since logout must stay a
// CSRF-protected POST.
func navItemsJSON(v View) string {
	items := []navItem{}
	if v.Identity.Role == domain.RoleDriver {
		items = append(items, navItem{ID: "my_trips", Name: v.T("nav.my_trips"), Href: "/my/trips", Active: isActivePath(v.Path, "/my/trips")})
	} else {
		items = append(items,
			navItem{ID: "timeline", Name: v.T("nav.timeline"), Href: "/timeline", Active: isActivePath(v.Path, "/timeline")},
			navItem{ID: "trips", Name: v.T("nav.trips"), Href: "/trips", Active: isActivePath(v.Path, "/trips")},
			navItem{ID: "buses", Name: v.T("nav.buses"), Href: "/buses", Active: isActivePath(v.Path, "/buses")},
			navItem{ID: "drivers", Name: v.T("nav.drivers"), Href: "/drivers", Active: isActivePath(v.Path, "/drivers")},
		)
	}
	if v.Identity.Role == domain.RoleAdmin {
		items = append(items, navItem{ID: "users", Name: v.T("nav.users"), Href: "/users", Active: isActivePath(v.Path, "/users")})
	}
	items = append(items, navItem{ID: "logout", Name: v.T("nav.logout")})

	raw, err := json.Marshal(items)
	if err != nil {
		return "[]" // never fails in practice: navItem is plain strings and a bool
	}
	return string(raw)
}

func isActivePath(currentPath, linkPath string) bool {
	return currentPath == linkPath || strings.HasPrefix(currentPath, linkPath+"/")
}

// NavLink highlights itself when it matches (or is an ancestor of) the current path,
// e.g. "/trips" stays active on "/trips/42".
templ NavLink(v View, href, label string) {
	<a href={ templ.SafeURL(href) } class={ navLinkClass(v.Path, href) }>{ label }</a>
}

func navLinkClass(currentPath, linkPath string) string {
	if isActivePath(currentPath, linkPath) {
		return "rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white"
	}
	return "rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
}

// htmxConfigJSON builds the <meta name="htmx-config"> content — see the comment beside
// its use in Layout(). includeIndicatorStyles is off because nothing in this app uses
// hx-indicator; inlineStyleNonce is set anyway so it is already correct if that changes.
func htmxConfigJSON(nonce string) string {
	raw, err := json.Marshal(map[string]any{
		"includeIndicatorStyles": false,
		"inlineStyleNonce":       nonce,
	})
	if err != nil {
		return `{"includeIndicatorStyles":false}` // never fails in practice
	}
	return string(raw)
}
