package templates

import "github.com/buscompany/bus_fleet/internal/i18n"

// ErrorPage shows a translated message chosen by the handler. Internal error detail
// never reaches the browser.
templ ErrorPage(p *i18n.Printer, nonce, message string) {
	@Layout(p, nonce, p.T("error.title")) {
		<div class="mx-auto mt-16 max-w-sm text-center">
			<h1 class="mb-2 text-xl font-semibold text-slate-900">{ p.T("error.title") }</h1>
			<p class="text-slate-600">{ message }</p>
			<p class="mt-6">
				<a class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" href="/">
					{ p.T("common.back") }
				</a>
			</p>
		</div>
	}
}

// OfflinePage is what the service worker shows when the phone has no connection.
// It is cached at install time, so it must not depend on any live data.
templ OfflinePage(v View) {
	@Layout(v.P, v.Nonce, v.T("offline.title")) {
		<div class="mx-auto mt-16 max-w-sm text-center">
			<h1 class="mb-2 text-xl font-semibold text-slate-900">{ v.T("offline.title") }</h1>
			<p class="text-slate-600">{ v.T("offline.body") }</p>
			<p class="mt-6">
				<a class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" href="/my/trips">
					{ v.T("offline.retry") }
				</a>
			</p>
		</div>
	}
}
